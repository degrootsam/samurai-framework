{
  "name": "@itmetsam/samurai-framework",
  "version": "0.1.0",
  "description": "",
  "main": "dist/api.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./runner": {
      "types": "./dist/runner/run.d.ts",
      "default": "./dist/runner/run.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    },
    "./recorder": {
      "types": "./dist/recorder/index.d.ts",
      "default": "./dist/recorder/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "test": "tsx --test --test-timeout=10000 \"src/**/*.test.ts\"",
    "test:browser": "tsx --test --test-concurrency=1 \"src/**/*.browser-test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "typescript": "^6.0.2",
    "winston": "^3.19.0"
  },
  "types": "dist/api.d.ts",
  "files": [
    "dist"
  ]
}
