{
  "name": "@itmetsam/samurai-framework",
  "version": "0.22.13",
  "description": "Browser test framework over WebDriver BiDi: auto-waiting locators, environments and secrets, a recorder, and a command line.",
  "main": "dist/api.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./runner": {
      "types": "./dist/runner/run.d.ts",
      "default": "./dist/runner/run.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    },
    "./recorder": {
      "types": "./dist/recorder/index.d.ts",
      "default": "./dist/recorder/index.js"
    },
    "./init": {
      "types": "./dist/cli/init.d.ts",
      "default": "./dist/cli/init.js"
    },
    "./browsers": {
      "types": "./dist/browsers/index.d.ts",
      "default": "./dist/browsers/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./flows": {
      "types": "./dist/flows/core/index.d.ts",
      "default": "./dist/flows/core/index.js"
    },
    "./flows/run": {
      "types": "./dist/flows/run/index.d.ts",
      "default": "./dist/flows/run/index.js"
    },
    "./flows/steps": {
      "types": "./dist/flows/steps/index.d.ts",
      "default": "./dist/flows/steps/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "default": "./dist/project/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-types.mjs",
    "build-watch": "node scripts/copy-types.mjs && tsc -w --preserveWatchOutput -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit --noUnusedLocals",
    "test": "SAMURAI_LOG_LEVEL=${SAMURAI_LOG_LEVEL:-warn} tsx --import ./scripts/test-tmp.mjs --test --test-timeout=10000 \"src/**/*.test.ts\"",
    "test-browser": "SAMURAI_LOG_LEVEL=${SAMURAI_LOG_LEVEL:-warn} tsx --import ./scripts/test-tmp.mjs --test --test-concurrency=1 --test-timeout=60000 $(node scripts/browser-shards.mjs)",
    "test-browser-chrome": "SAMURAI_TEST_BROWSER=chrome bun run test-browser",
    "test-cli": "tsx --import ./scripts/test-tmp.mjs --test --test-concurrency=1 \"src/**/*.cli-test.ts\"",
    "knip": "knip --no-config-hints",
    "madge": "madge --circular src"
  },
  "keywords": [
    "testing",
    "browser",
    "e2e",
    "webdriver-bidi",
    "firefox",
    "recorder"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ai": "^7.0.0",
    "esbuild": "^0.28.2",
    "knip": "^6.42.1",
    "madge": "^8.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.8"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.4",
    "typescript": "^6.0.2",
    "winston": "^3.19.0"
  },
  "types": "dist/api.d.ts",
  "files": [
    "dist",
    "bin",
    "AGENT-GUIDE.md"
  ],
  "bin": {
    "samurai": "bin/samurai.mjs"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "tsx": "^4.21.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/degrootsam/samurai-framework.git"
  },
  "homepage": "https://github.com/degrootsam/samurai-framework#readme",
  "bugs": {
    "url": "https://github.com/degrootsam/samurai-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "nx": {
    "name": "framework",
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      },
      "test-cli": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "parallelism": false
      },
      "test-browser": {
        "cache": true,
        "parallelism": false,
        "inputs": [
          "default",
          {
            "env": "SAMURAI_TEST_BROWSER"
          },
          {
            "env": "SAMURAI_TEST_SHARD"
          }
        ]
      },
      "build-watch": {
        "continuous": true,
        "cache": false
      }
    }
  }
}
